@model WebApplication1.Models.ContactInfo

<h2>Add Contact</h2>

<form asp-action="AddContact" method="post">
    <label>Contact Id</label>
    <input asp-for="ContactId" /><br />

    <label>First Name</label>
    <input asp-for="FirstName" /><br />

    <label>Last Name</label>
    <input asp-for="LastName" /><br />

    <label>Company Name</label>
    <input asp-for="CompanyName" /><br />

    <label>Email</label>
    <input asp-for="EmailId" /><br />

    <label>Mobile</label>
    <input asp-for="MobileNo" /><br />

    <label>Designation</label>
    <input asp-for="Designation" /><br />

    <button type="submit">Save</button>
</form>