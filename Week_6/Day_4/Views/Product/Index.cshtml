@using WebApplication2.Models;
@model List<Product>

<h1>Products Details</h1>

<table border="1" cellpadding="10" cellspacing="0" class="table table-dark">
    <thead>
        <tr>
            <th>Id:</th>
            <th>Name:</th>
            <th>Category:</th>
            <th>Price:</th>
        </tr>
    </thead>

    <tbody>
        @foreach(Product product in Model)
        {
            <tr>
                <td>@product.ProductId</td>
                <td>@product.ProductName</td>
                <td>@product.Category</td>
                <td>@product.Price</td>
            </tr>
        }
    </tbody>
</table>